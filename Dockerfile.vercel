# Menggunakan base image FrankenPHP resmi yang sangat cocok untuk Vercel
FROM dunglas/frankenphp:latest-alpine

# Install ekstensi PHP yang dibutuhkan Laravel (misal: pdo_mysql untuk database)
RUN install-php-extensions pdo_mysql bcmath opcache zip intl

# Atur direktori kerja di dalam kontainer
WORKDIR /app

# Salin seluruh file proyek Laravel ke dalam kontainer
COPY . .

# Install dependensi Composer untuk kebutuhan production
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Berikan hak akses folder storage dan cache ke user server
RUN chown -R www-data:www-data storage bootstrap/cache

# Vercel akan mengarahkan traffic ke port secara dinamis melalui env $PORT
ENV PORT=80
EXPOSE 80

# Jalankan FrankenPHP dan arahkan root dokumen ke folder public Laravel
CMD ["frankenphp", "php-server", "--listen", ":80", "--public-dir", "public"]
