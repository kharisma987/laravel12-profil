# 1. Menggunakan base image FrankenPHP resmi
FROM dunglas/frankenphp:latest-alpine

# 2. Ambil Composer resmi dari image composer dan masukkan ke server kita (BARIS BARU)
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 3. Install ekstensi PHP yang dibutuhkan Laravel
RUN install-php-extensions pdo_mysql bcmath opcache zip intl

# 4. Atur direktori kerja
WORKDIR /app

# 5. Salin seluruh file proyek
COPY . .

# 6. Jalankan composer install (sekarang komandonya pasti ketemu)
RUN composer install --no-dev --optimize-autoloader --no-interaction

# 7. Berikan hak akses folder storage dan cache
RUN chown -R www-data:www-data storage bootstrap/cache

ENV PORT=80
EXPOSE 80

# 8. Jalankan FrankenPHP
CMD ["frankenphp", "php-server", "--listen", ":80", "--public-dir", "public"]
